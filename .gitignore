# Large sequencing files - never commit these
*.bam
*.bai
*.fastq
*.fastq.gz
*.fa
*.fasta
data/bam/
data/vcf/reference/
screenshots/*.png

# Python
__pycache__/
*.pyc
.env

# Conda
*.egg-info/
dist/
build/
Miniconda3-latest-Linux-x86_64.sh
.vscode/

# Secrets
.api/

# Generated IGV screenshots.
# Post-FIX-C the server assigns output paths under its own session directory,
# so model-generated images no longer land at repo root. These rules cover
# that directory plus a catch-all for any stray PNG or image directory a
# pre-FIX-C run (or a direct bam_tools call) leaves in the root -- the tool
# API no longer lets a model choose a path, but a script still can.
stage1_igv_assistant/screenshots/sessions/
/*.png
/*_evidence/
/evidence_panel*/
/sv_report_*/
